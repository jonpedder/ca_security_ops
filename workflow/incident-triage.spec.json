{
  "$comment": "Audited Watch Center workflow using the California Security Operations - Request Approval lifecycle, lookup values, groups, and request_details fields. incident_audit stores the latest structured audit state; native comments and history retain the append-only event trail.",
  "workflowItem": {
    "title": "Watch Center Incident Triage Audited",
    "description": "Audited Watch Center incident handling using the California Security Operations request review and approval lifecycle and values."
  },
  "category": "Security Operations",
  "intake": {
    "type": "application"
  },
  "groups": {
    "coordinators": {
      "title": "Security Requests - Coordinators",
      "description": "Coordinates intake, revisions, fulfillment, and completion review.",
      "roles": [
        "Manage Jobs - Basic",
        "Manage Jobs - Advanced"
      ]
    },
    "approvers": {
      "title": "Security Requests - Approvers",
      "description": "Performs formal security request approval decisions.",
      "roles": [
        "Manage Jobs - Basic"
      ]
    }
  },
  "lookups": {
    "priority": [
      {
        "lookupName": "Low",
        "value": 0
      },
      {
        "lookupName": "Medium",
        "value": 5
      },
      {
        "lookupName": "High",
        "value": 10
      }
    ],
    "status": [
      {
        "lookupName": "Submitted",
        "value": 0
      },
      {
        "lookupName": "Created",
        "value": 1
      },
      {
        "lookupName": "Ready",
        "value": 2
      },
      {
        "lookupName": "In Progress",
        "value": 3
      },
      {
        "lookupName": "Incomplete",
        "value": 4
      },
      {
        "lookupName": "Revised",
        "value": 5
      },
      {
        "lookupName": "Pending",
        "value": 6
      },
      {
        "lookupName": "On Hold",
        "value": 7
      },
      {
        "lookupName": "Approved",
        "value": 8
      },
      {
        "lookupName": "Completed",
        "value": 9
      },
      {
        "lookupName": "Closed",
        "value": 10
      }
    ]
  },
  "diagram": {
    "name": "Security Request Review and Approval - Audited",
    "description": "Coordinator intake and completeness check, formal approver decision, revision loop, fulfillment, closure, and auditable incident state.",
    "initialStep": "request-received",
    "steps": [
      {
        "key": "request-received",
        "name": "Request Received",
        "kind": "startEnd",
        "at": {
          "x": 0,
          "y": 0
        },
        "automatic": true,
        "proceedNext": true,
        "prompt": "A new request has been logged. Review Request Details and proceed to intake."
      },
      {
        "key": "intake-review",
        "name": "Intake and Completeness Review",
        "kind": "manual",
        "at": {
          "x": 220,
          "y": 0
        },
        "group": "coordinators",
        "userRun": true,
        "prompt": "Coordinator: verify requester, request type, operational area, justification, priority, and supporting information."
      },
      {
        "key": "complete-question",
        "name": "Request Complete?",
        "kind": "question",
        "at": {
          "x": 440,
          "y": 0
        },
        "group": "coordinators",
        "question": "Is the request complete and ready for approval?",
        "responses": [
          {
            "key": "Yes",
            "displayName": "Yes",
            "value": 1
          },
          {
            "key": "NeedsInformation",
            "displayName": "Needs information",
            "value": 0
          }
        ]
      },
      {
        "key": "request-information",
        "name": "Collect Additional Information",
        "kind": "manual",
        "at": {
          "x": 440,
          "y": 180
        },
        "group": "coordinators",
        "userRun": true,
        "prompt": "Contact the requester, collect missing information, and update Request Details before resubmitting."
      },
      {
        "key": "approval-review",
        "name": "Approval Review",
        "kind": "manual",
        "at": {
          "x": 680,
          "y": 0
        },
        "group": "approvers",
        "userRun": true,
        "prompt": "Approver: review the complete request, business justification, priority, and operational impact. Record decision notes."
      },
      {
        "key": "approval-question",
        "name": "Approval Decision",
        "kind": "question",
        "at": {
          "x": 900,
          "y": 0
        },
        "group": "approvers",
        "question": "What is the approval decision?",
        "responses": [
          {
            "key": "Approved",
            "displayName": "Approved",
            "value": 1
          },
          {
            "key": "ChangesRequired",
            "displayName": "Changes required",
            "value": 2
          },
          {
            "key": "Rejected",
            "displayName": "Rejected",
            "value": 0
          }
        ]
      },
      {
        "key": "revise-request",
        "name": "Revise Request",
        "kind": "manual",
        "at": {
          "x": 900,
          "y": 180
        },
        "group": "coordinators",
        "userRun": true,
        "prompt": "Coordinator: address approver comments, update the request, and return it for approval."
      },
      {
        "key": "fulfill-request",
        "name": "Fulfill Approved Request",
        "kind": "manual",
        "at": {
          "x": 1140,
          "y": -90
        },
        "group": "coordinators",
        "userRun": true,
        "prompt": "Coordinator: carry out or coordinate the approved work. Record completion evidence and notes."
      },
      {
        "key": "completion-review",
        "name": "Completion Verified?",
        "kind": "question",
        "at": {
          "x": 1360,
          "y": -90
        },
        "group": "coordinators",
        "question": "Has the approved request been fulfilled and documented?",
        "responses": [
          {
            "key": "Yes",
            "displayName": "Yes",
            "value": 1
          },
          {
            "key": "No",
            "displayName": "No",
            "value": 0
          }
        ]
      },
      {
        "key": "approved-closed",
        "name": "Approved Request Closed",
        "kind": "startEnd",
        "at": {
          "x": 1580,
          "y": -90
        },
        "automatic": true,
        "proceedNext": true,
        "prompt": "The approved request is complete. Confirm closure to finish the job."
      },
      {
        "key": "rejected-closed",
        "name": "Rejected Request Closed",
        "kind": "startEnd",
        "at": {
          "x": 1140,
          "y": 120
        },
        "automatic": true,
        "proceedNext": true,
        "prompt": "The request was rejected. Ensure decision notes are recorded, then confirm closure."
      }
    ],
    "paths": [
      {
        "from": "request-received",
        "to": "intake-review"
      },
      {
        "from": "intake-review",
        "to": "complete-question"
      },
      {
        "from": "complete-question",
        "to": "approval-review",
        "answer": 1
      },
      {
        "from": "complete-question",
        "to": "request-information",
        "answer": 0,
        "ports": [
          "BOTTOM",
          "TOP"
        ]
      },
      {
        "from": "request-information",
        "to": "intake-review",
        "ports": [
          "LEFT",
          "BOTTOM"
        ]
      },
      {
        "from": "approval-review",
        "to": "approval-question"
      },
      {
        "from": "approval-question",
        "to": "fulfill-request",
        "answer": 1
      },
      {
        "from": "approval-question",
        "to": "revise-request",
        "answer": 2,
        "ports": [
          "BOTTOM",
          "TOP"
        ]
      },
      {
        "from": "approval-question",
        "to": "rejected-closed",
        "answer": 0,
        "ports": [
          "BOTTOM",
          "LEFT"
        ]
      },
      {
        "from": "revise-request",
        "to": "approval-review",
        "ports": [
          "LEFT",
          "BOTTOM"
        ]
      },
      {
        "from": "fulfill-request",
        "to": "completion-review"
      },
      {
        "from": "completion-review",
        "to": "approved-closed",
        "answer": 1
      },
      {
        "from": "completion-review",
        "to": "fulfill-request",
        "answer": 0,
        "ports": [
          "BOTTOM",
          "BOTTOM"
        ]
      }
    ]
  },
  "jobTemplates": [
    {
      "name": "Watch Center Security Request Audited",
      "description": "Audited Watch Center incident using the California Security Operations request approval lifecycle and Request Details values.",
      "defaultPriority": "Medium",
      "defaultJobName": "SEC-REQ_[index]",
      "defaultJobDuration": 14,
      "defaultAssignment": {
        "group": "coordinators"
      },
      "extendedPropertyTables": [
        "request_details",
        "incident_audit"
      ],
      "shareWith": [
        "coordinators",
        "approvers"
      ]
    }
  ],
  "extendedPropertyTables": [
    {
